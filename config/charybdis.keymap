#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150
#include <dt-bindings/zmk/pointing.h>

#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#include "layers.h"

#include "behaviors.dtsi"
#include "combos.dtsi"

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
                &kp B     &kp L     &kp D     &kp W     &kp Z         &kp COMMA     &kp F        &kp O       &kp U        &kp J
                &hm_l LGUI N  &hm_l LALT R  &hm_l LSHFT T  &hm_l LCTRL S  &kp G    &kp Y  &hm_r RCTRL H  &hm_r RSHFT A  &hm_r RALT E  &hm_r RGUI I
                &kp Q     &kp X     &kp M     &kp C     &kp V         &kp K     &kp P        &kp ESC     &kp ENTER    &lt FUNC DOT
                          &kp LC(A) &lt NAV SPACE &kp TAB          &mo SYM   &lt NUM BSPC
            >;
        };

        NAV {
            display-name = "NAV";
            bindings = <
                &none     &none     &none     &none     &none         &none     &none     &none     &none      &kp EQUAL
                &kp LGUI  &kp LALT  &kp LSHFT &kp LCTRL &none         &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &kp MINUS
                &none     &none     &none     &none     &none         &none     &none     &none     &none      &none
                          &none     &none     &none                   &none     &kp BSPC
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
                &none     &kp N7    &kp N8    &kp N9    &none         &bt BT_SEL 0   &bt BT_SEL 1 &none    &out OUT_TOG &bt BT_CLR
                &none     &kp N4    &kp N5    &kp N6    &none         &none          &kp RCTRL  &kp RSHFT  &kp RALT  &kp RGUI
                &none     &kp N1    &kp N2    &kp N3    &none         &studio_unlock &kp PSCRN  &none      &none     &none
                          &none     &kp N0    &none                   &none     &none
            >;
        };

        SYM {
            display-name = "SYM";
            bindings = <
                &kp GRAVE &kp EXCL  &kp LBRC  &kp RBRC  &kp HASH      &kp QMARK &kp LBKT  &kp RBKT  &kp PLUS   &kp AT
                &kp AMPS  &kp CARET &kp EQUAL &kp UNDER &kp DLLR      &kp APOS  &kp LPAR  &kp RPAR  &kp SEMI   &kp COLON
                &kp TILDE &kp LT    &kp PIPE  &kp MINUS &kp GT        &kp FSLH  &kp STAR  &kp DOT   &kp DQT    &none
                          &none     &kp BSLH  &kp PRCNT               &none     &none
            >;
        };

        FUNC {
            display-name = "FUNC";
            bindings = <
                &none     &kp F7    &kp F8    &kp F9    &kp F12       &none     &none      &none      &none     &none
                &none     &kp F4    &kp F5    &kp F6    &kp F11       &none     &kp RCTRL  &kp RSHFT  &kp RALT  &kp RGUI
                &none     &kp F1    &kp F2    &kp F3    &kp F10       &none     &none      &none      &none     &none
                          &none     &none     &none                   &none     &none
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
			&trans    &trans    &trans     &trans    &trans        &trans    &trans     &trans     &trans    &trans
			&trans    &mkp LCLK &mkp MCLK  &mkp RCLK &trans        &trans    &mkp LCLK  &mkp MCLK  &mkp RCLK &trans
			&trans    &trans    &mo SCROLL &mo SNIPE &trans        &trans    &mo SCROLL &mo SNIPE  &trans    &trans
					  &mkp MCLK &mkp LCLK  &mkp RCLK                &trans    &trans
			>;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                       &trans &trans &trans           &trans &trans
            >;
        };

        SNIPE {
            display-name = "SNIPE";
            bindings = <
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                       &trans &trans &trans           &trans &trans
            >;
        };

        AUTO {
            display-name = "AUTO";
            bindings = <
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
                       &trans &trans &trans           &trans &trans
            >;
        };
    };
};
